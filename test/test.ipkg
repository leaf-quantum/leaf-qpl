package leaf-tests

sourcedir = "."

depends = leaf,
          elab-util,
          finite,
          ilex,
          parser,
          simple-tests

modules = Lexer.LexerTest,
          Parser.ExpressionParseTest,
          Parser.FunctionParseTest,
          Parser.TopModuleParseTest,
          Parser.ValidationTests,
          ScopeAndNameResolution.ValidationTest,
          ScopeAndNameResolution.PreludeTestHelper,
          ScopeAndNameResolution.PreludeTest,
          ScopeAndNameResolution.Helper,
          ScopeAndNameResolution.ResolveTestHelper,
          ScopeAndNameResolution.ResolveTest,
	  TypeChecker.Helper,
          TypeChecker.Phases.BodyCheckTest,
          TypeChecker.Phases.ConstEvalTest,
          TypeChecker.Phases.EffectsCheckTest,
          TypeChecker.Phases.OwnershipCheckTest,
          TypeChecker.Phases.OwnershipEventsTest,
          TypeChecker.Phases.SignatureCheckTest,
          TypeChecker.Phases.TypedAstTranslationTest,
          TypeChecker.TypeCheckTest,
          TypeChecker.TypeTranslationTest,
          CompileCodeExamples,
          Run

main = Run
executable = leaf-tests
